<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.taoqi</groupId>
        <artifactId>taoqi-agent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>taoqi-agent-starter</artifactId>
    <!-- 服务独立版本号：修改时同步根 pom 的 taoqi-agent-starter.version -->
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <description>自定义 Spring Boot Starter：引入即自动为 Servlet 应用加上 traceId 与访问日志</description>

    <dependencies>
        <!-- 自动配置能力（@AutoConfiguration、条件注解、配置绑定）由 spring-boot-starter 传递引入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 过滤器需要 Web 环境；声明为 optional，使用方即使不是 Web 应用也不会被强制引入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 编译期生成 spring-configuration-metadata.json，为 IDE 提供配置项提示，不进入运行时 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
